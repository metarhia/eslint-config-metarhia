{
  "name": "eslint-config-metarhia",
  "version": "10.0.1",
  "author": "Alexey Orlenko <eaglexrlnk@gmail.com>",
  "license": "MIT",
  "description": "ESLint 10 shareable config and JavaScript styleguide for Metarhia",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "styleguide",
    "javascript",
    "node.js",
    "flat-config",
    "lint",
    "linter",
    "config",
    "preset",
    "metarhia"
  ],
  "main": "index.js",
  "files": [
    "rules/"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metarhia/eslint-config-metarhia.git"
  },
  "bugs": {
    "url": "https://github.com/metarhia/eslint-config-metarhia/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "scripts": {
    "test": "npm run -s lint",
    "lint": "eslint . && prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\"",
    "fix": "eslint . --fix && prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\""
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "metaskills": "^1.0.6"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
